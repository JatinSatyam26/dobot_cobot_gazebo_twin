      </visual>
      <visual name="gx9">
        <pose>1.0 0 -0.9895999999999999 0 0 0</pose>
        <geometry><box><size>0.006 6.0 0.002</size></box></geometry>
        <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material>
      </visual>
      <visual name="gy9">
        <pose>0 1.0 -0.9895999999999999 0 0 0</pose>
        <geometry><box><size>6.0 0.006 0.002</size></box></geometry>
