      </visual>
      </link>
    </model>

    <!-- ============ wooden workbench — THE CELL DATUM ============ -->
    <model name="workbench">
      <static>true</static>
      <link name="link">
        <visual name="slab">
          <pose>0 0 -0.01270 0 0 0</pose>
          <geometry><box><size>1.52400 0.60960 0.02540</size></box></geometry>
          <material><ambient>0.60 0.50 0.34 1</ambient><diffuse>0.87 0.75 0.56 1</diffuse></material>
        </visual>
        <collision name="slab_c">
          <pose>0 0 -0.01270 0 0 0</pose>
          <geometry><box><size>1.52400 0.60960 0.02540</size></box></geometry>
        </collision>
      <visual name="leg_0">
        <pose>0.53975 0.23495 -0.50800 0 0 0</pose>
        <geometry><box><size>0.03810 0.03810 0.96520</size></box></geometry>
        <material><ambient>0.09 0.09 0.10 1</ambient><diffuse>0.20 0.21 0.23 1</diffuse></material>
      </visual>
      <collision name="leg_0_c">
        <pose>0.53975 0.23495 -0.50800 0 0 0</pose>
        <geometry><box><size>0.03810 0.03810 0.96520</size></box></geometry>
      </collision>
      <visual name="leg_1">
        <pose>0.53975 -0.23495 -0.50800 0 0 0</pose>
        <geometry><box><size>0.03810 0.03810 0.96520</size></box></geometry>
        <material><ambient>0.09 0.09 0.10 1</ambient><diffuse>0.20 0.21 0.23 1</diffuse></material>
      </visual>
      <collision name="leg_1_c">
        <pose>0.53975 -0.23495 -0.50800 0 0 0</pose>
        <geometry><box><size>0.03810 0.03810 0.96520</size></box></geometry>
      </collision>
      <visual name="leg_2">
        <pose>-0.53975 0.23495 -0.50800 0 0 0</pose>
        <geometry><box><size>0.03810 0.03810 0.96520</size></box></geometry>
        <material><ambient>0.09 0.09 0.10 1</ambient><diffuse>0.20 0.21 0.23 1</diffuse></material>
      </visual>
      <collision name="leg_2_c">
        <pose>-0.53975 0.23495 -0.50800 0 0 0</pose>
        <geometry><box><size>0.03810 0.03810 0.96520</size></box></geometry>
      </collision>
      <visual name="leg_3">
        <pose>-0.53975 -0.23495 -0.50800 0 0 0</pose>
        <geometry><box><size>0.03810 0.03810 0.96520</size></box></geometry>
        <material><ambient>0.09 0.09 0.10 1</ambient><diffuse>0.20 0.21 0.23 1</diffuse></material>
      </visual>
      <collision name="leg_3_c">
        <pose>-0.53975 -0.23495 -0.50800 0 0 0</pose>
        <geometry><box><size>0.03810 0.03810 0.96520</size></box></geometry>
      </collision>
      </link>
    </model>

    <!-- ============ robot mounting plates ============
         Both arms are bolted to black plates, not straight to the board (see
         reference_photos). Plate OUTLINE is read off the rectified plan
         (+/-20 mm); THICKNESS is ASSUMED - 8 mm is a guess, and it sets the
         base height of both robots. Metrology: m1pro_plate, pro600_plate. -->
    <model name="m1pro_plate">
      <static>true</static>
      <pose>-0.600 0.188 0.004 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.180 0.232 0.008</size></box></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse>
                    <specular>0.3 0.3 0.3 1</specular></material>
        </visual>
        <collision name="c"><geometry><box><size>0.180 0.232 0.008</size></box></geometry></collision>
      </link>
    </model>
    <model name="pro600_plate">
      <static>true</static>
      <pose>0.600 0.200 0.004 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.200 0.200 0.008</size></box></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse>
                    <specular>0.3 0.3 0.3 1</specular></material>
        </visual>
        <collision name="c"><geometry><box><size>0.200 0.200 0.008</size></box></geometry></collision>
      </link>
    </model>

    <!-- ============ conveyor DT-AC-CB070-02E ============
         Mesh VISUAL (metres, Y-up -> roll 90deg; yaw 180deg puts the motor
         block at the -X REAR corner where the photographs have it). Collision
         is a primitive: the mesh is third-party, unverified, and mesh
         collision at 11.6k triangles is far too slow for real-time physics.
         Mesh bbox is centred on the real belt centreline y = +0.135. -->
    <model name="conveyor_frame">
      <static>true</static>
      <pose>0.28407 0.154 0.02665 1.5708 0 3.14159</pose>
      <link name="link">
        <visual name="v">
          <geometry>
            <mesh><uri>package://wafer_cell_bringup/meshes/dobot_conveyor.stl</uri>
                  <scale>1 1 1</scale></mesh>
          </geometry>
          <material><ambient>0.13 0.13 0.15 1</ambient><diffuse>0.26 0.26 0.29 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="conveyor_collision">
      <static>true</static>
      <pose>0 0.135 0.03132 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.698 0.150 0.06265</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============ yellow wafer tower — M1 Pro end ============
         STL is Y-up with its OPEN chord on +X; roll 90deg stands it up, yaw
         180deg turns the opening toward world -X, i.e. toward the M1 Pro, so
         the fork enters along +X. Direction VERIFIED from the photographs,
         position ESTIMATED (+/-20 mm). Numbers mirror cell_layout.py.
         Metrology: nest_poses -->
    <model name="tower_yellow">
      <static>true</static>
      <pose>-0.353 -0.162 0.005 1.5708 0 3.14159</pose>
      <link name="link">
        <visual name="v">
          <geometry><mesh><uri>package://wafer_cell_bringup/meshes/wafer_tower.stl</uri>
                          <scale>0.001 0.001 0.001</scale></mesh></geometry>
          <material><ambient>0.55 0.48 0.05 1</ambient><diffuse>0.92 0.82 0.10 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><mesh><uri>package://wafer_cell_bringup/meshes/wafer_tower.stl</uri>
                          <scale>0.001 0.001 0.001</scale></mesh></geometry>
        </collision>
      </link>
    </model>

    <!-- ============ blue wafer tower — Pro 600 end (SAME PART) ============
         Opens toward -X like the yellow one (owner's instruction 2026-09-04;
         the 2026-09-02 photo showed +X). Mirrors cell_layout.py. -->
    <model name="tower_blue">
      <static>true</static>
      <pose>0.430 -0.153 0.005 1.5708 0 3.14159</pose>
      <link name="link">
        <visual name="v">
          <geometry><mesh><uri>package://wafer_cell_bringup/meshes/wafer_tower.stl</uri>
                          <scale>0.001 0.001 0.001</scale></mesh></geometry>
          <material><ambient>0.06 0.16 0.42 1</ambient><diffuse>0.13 0.32 0.75 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><mesh><uri>package://wafer_cell_bringup/meshes/wafer_tower.stl</uri>
                          <scale>0.001 0.001 0.001</scale></mesh></geometry>
        </collision>
      </link>
    </model>

    <!-- ===================================================================
         BELT WAYPOINTS (belt_travel joint = world X, centreline y = +0.135)
         A x=-0.14 load     B x=+0.03 dwell (none seen in the 09-03 video)
         C x=+0.20 unload.  Values in cell_layout.py (BELT_A/B/C).
         Belt surface z = 0.06265;  holder wafer seat z = 0.10765
         =================================================================== -->
    <!-- ===================================================================
         INSPECTION CAMERA — verification tool, not part of the cell.
         Lets the build be checked headlessly instead of relying on someone
         looking at the GUI. Capture with:
             ros2 run wafer_cell_bringup capture_view.py
         =================================================================== -->
    <model name="inspection_cam">
      <static>true</static>
      <pose>-0.150 -1.750 0.620 0 0.28800 1.48538</pose>
      <link name="link">
        <sensor name="cell_cam" type="camera">
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image><width>1280</width><height>800</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>50</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>cell_cam</topic>
        </sensor>
      </link>
    </model>

    <!-- CLOSE-UPS for millimetre checks of the wafer seating (owner review):
         /detail_blue_cam looks at the blue nest, /detail_belt_cam at the belt
         holder at point A. capture_view.py <out> /detail_blue_cam -->
    <model name="detail_blue_cam">
      <static>true</static>
      <pose>0.300 -0.450 0.280 0 0.553 1.157</pose>
      <link name="link">
        <sensor name="detail_blue_cam" type="camera">
          <camera><horizontal_fov>0.55</horizontal_fov>
            <image><width>1024</width><height>768</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10</far></clip></camera>
          <always_on>1</always_on><update_rate>5</update_rate><topic>detail_blue_cam</topic>
        </sensor>
      </link>
    </model>
    <model name="detail_belt_cam">
      <static>true</static>
      <pose>0.080 0.135 0.215 0 0.470 3.14159</pose>
      <link name="link">
        <sensor name="detail_belt_cam" type="camera">
          <camera><horizontal_fov>0.55</horizontal_fov>
            <image><width>1024</width><height>768</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10</far></clip></camera>
          <always_on>1</always_on><update_rate>5</update_rate><topic>detail_belt_cam</topic>
        </sensor>
      </link>
    </model>

    <model name="detail_beltc_cam">
      <static>true</static>
      <pose>0.040 -0.150 0.250 0 0.455 1.060</pose>
      <link name="link">
        <sensor name="detail_beltc_cam" type="camera">
          <camera><horizontal_fov>0.55</horizontal_fov>
            <image><width>1024</width><height>768</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10</far></clip></camera>
          <always_on>1</always_on><update_rate>5</update_rate><topic>detail_beltc_cam</topic>
        </sensor>
      </link>
    </model>

    <model name="detail_yellow_cam">
      <static>true</static>
      <pose>-0.550 -0.450 0.250 0 0.430 0.971</pose>
      <link name="link">
        <sensor name="detail_yellow_cam" type="camera">
          <camera><horizontal_fov>0.55</horizontal_fov>
            <image><width>1024</width><height>768</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10</far></clip></camera>
          <always_on>1</always_on><update_rate>5</update_rate><topic>detail_yellow_cam</topic>
        </sensor>
      </link>
    </model>

    <!-- PLAN VIEW. Orientation of the towers and the belt is impossible to
         judge from an oblique view - the C's opening can hide behind its own
         back wall. This looks straight down so facing is unambiguous.
             ros2 run wafer_cell_bringup capture_view.py out.png /plan_cam -->
    <model name="plan_cam">
      <static>true</static>
      <!-- NOT exactly straight down: at pitch 1.5708 ogre2 hits the up-vector
           degeneracy and the sensor renders nothing at all (verified - the gz
           topic existed and never published). 1.44 is 8 deg off vertical. -->
      <pose>0 -0.30 1.90 0 1.44 1.5708</pose>
      <link name="link">
        <sensor name="plan_cam" type="camera">
          <camera>
            <horizontal_fov>0.95</horizontal_fov>
            <image><width>1280</width><height>800</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>50</far></clip>
          </camera>
          <always_on>1</always_on><update_rate>10</update_rate>
          <topic>plan_cam</topic>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
