<?xml version="1.0" ?>
<!--
  ===========================================================================
  Wafer-handling cell — Gazebo Harmonic (gz-sim 8)
  ===========================================================================
  FRAME:  world z = 0 is the TOP SURFACE of the wooden workbench.
          +X = wafer flow, M1 Pro -> Pro 600.  +Z up.  Ground at z = -0.9906.

  MEASURED (owner, imperial -> metric):
      bench slab   60 x 24 x 1 in   = 1.5240 x 0.6096 x 0.0254 m
      top height   39 in            = 0.9906 m above ground
      legs         1.5 x 1.5 in     = 0.0381 m square, 0.9652 m tall
      leg inset    2 in from the long (60") edges, 8 in from the short (24")
      leg centres  x = +/-0.53975   y = +/-0.23495
      wafer        5 in diameter    = 0.1270 m  -> radius 0.06350

  EXACT geometry from customer STLs:
      wafer_tower  107.5 x 135.0 footprint, 100 tall, shelves at 50/72/94 mm
      belt_holder  180 (along belt) x 70 (across) x 45 tall, flat top

  CONVEYOR MESH — third-party, treat with suspicion:
      Sourced from a 3D Warehouse SketchUp model, converted to STL. It is in
      METRES (scale 1.0, not 0.001) and its facet winding was inconsistent
      (5518 of 11603 facets had inverted normals) — repaired in place.
      Overall 698 x 214.5 x 62.6 mm, belt carrying surface 36.0 mm above the
      model origin, i.e. z = 0.06265 with the frame sat on the bench.
      The 698 mm length agrees with the photo estimate, but NOTHING here is
      verified against the real DT-AC-CB070-02E. Used for VISUAL ONLY;
      collision is a primitive box. Metrology: belt_width_and_length,
      belt_top_height.

  LAYOUT — INTERIM, 2026-09-03 (photo-derived, +/-20 mm). Every number in
  this file mirrors scripts/cell_layout.py; check_extents.py asserts they
  agree. Source: the owner's overhead photograph
  docs/reference_photos_2/20260902_114748.heic rectified to a 1 px = 1 mm plan
  (homography on the board corners, parallax corrected). Method and the
  sim-vs-photo table: docs/research_2026-09-03/RESEARCH_REVIEW.md section 4.
      conveyor centreline y = +0.135 (rails read at +0.07..+0.20). The mesh is
      a 215 mm-wide lookalike of a ~137 mm frame; it is centred on the real
      centreline. It is now yawed 180 deg: the REAL stepper motor sits at the
      -X end on the REAR side (see the rectified plan), the mesh had it at +X
      front. Metrology: belt_centreline_y, conveyor_yaw.
      M1 Pro  base (-0.600, +0.188): black base flush with the rear edge in the
              photo; the 230 mm-deep Dobot base casting then sits 0.8 mm inside
              the edge. Yaw 0 is UNMEASURED and unchanged.
      Pro 600 base (+0.600, +0.200). Yaw pi UNMEASURED and unchanged.
      yellow nest (-0.353, -0.162), open chord toward -X (toward the M1 Pro;
              the fork enters along +X). VERIFIED direction, ESTIMATED position.
      blue nest   (+0.430, -0.153), open chord toward +X (toward the Pro 600).
      Both nests are 150-170 mm closer to the bench centre than the previous
      guess, and sit IN FRONT of the belt ends rather than beside them.
      Model origin of each nest = the wafer-seat arc centre (the three shelf
      rings fit circles centred within 3 mm of the STL origin).
  ⚠️  BASE YAW angles are still unmeasured. Yaw is the highest-leverage number
      in the cell: 1 deg = ~7 mm at the M1 Pro's reach. Metrology:
      m1pro_base_yaw / pro600_base_yaw. Rest poses are FK-solved, not from the
      pendant: m1pro_home / pro600_home.
  ===========================================================================
-->
<sdf version="1.10">
  <world name="wafer_cell">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <!-- Collision detector stays ODE (DART default). Bullet was tried on
           2026-09-04: it treats the C-shaped nest meshes as convex hulls and
           the fork can no longer enter them. ODE's thin-cylinder vs box
           contacts proved exact to <1 mm once the fork's approach path
           stopped sweeping through the wafer (cell_plan.py). -->
    </physics>

    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"           name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8066</gravity>

    <scene>
      <ambient>0.55 0.55 0.58 1</ambient>
      <background>0.78 0.82 0.87 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 6 0 0 0</pose>
      <diffuse>0.95 0.94 0.90 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.35 0.4 -0.85</direction>
    </light>
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 4 0 0 0</pose>
      <diffuse>0.35 0.36 0.40 1</diffuse>
      <direction>0.5 -0.3 -0.75</direction>
    </light>

    <!-- ground plane + explicit 0.5 m reference grid drawn ON it. Gazebo's own
         <grid> would sit at world z=0, which here is the BENCH TOP, not the
         floor — misleading. This grid is at the real floor height. -->
    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.99060 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.46 0.47 0.49 1</ambient><diffuse>0.58 0.59 0.61 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="floor_grid">
      <static>true</static>
      <link name="link">
      <visual name="gx1">
        <pose>-3.0 0 -0.9895999999999999 0 0 0</pose>
        <geometry><box><size>0.006 6.0 0.002</size></box></geometry>
        <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material>
      </visual>
      <visual name="gy1">
        <pose>0 -3.0 -0.9895999999999999 0 0 0</pose>
        <geometry><box><size>6.0 0.006 0.002</size></box></geometry>
        <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material>
      </visual>
      <visual name="gx2">
        <pose>-2.5 0 -0.9895999999999999 0 0 0</pose>
        <geometry><box><size>0.006 6.0 0.002</size></box></geometry>
        <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material>
      </visual>
      <visual name="gy2">
        <pose>0 -2.5 -0.9895999999999999 0 0 0</pose>
        <geometry><box><size>6.0 0.006 0.002</size></box></geometry>
        <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material>
      </visual>
      <visual name="gx3">
        <pose>-2.0 0 -0.9895999999999999 0 0 0</pose>
        <geometry><box><size>0.006 6.0 0.002</size></box></geometry>
        <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material>
      </visual>
      <visual name="gy3">
        <pose>0 -2.0 -0.9895999999999999 0 0 0</pose>
        <geometry><box><size>6.0 0.006 0.002</size></box></geometry>
        <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material>
      </visual>
      <visual name="gx4">
        <pose>-1.5 0 -0.9895999999999999 0 0 0</pose>
        <geometry><box><size>0.006 6.0 0.002</size></box></geometry>
        <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material>
      </visual>
      <visual name="gy4">
        <pose>0 -1.5 -0.9895999999999999 0 0 0</pose>
        <geometry><box><size>6.0 0.006 0.002</size></box></geometry>
        <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material>
      </visual>
      <visual name="gx5">
        <pose>-1.0 0 -0.9895999999999999 0 0 0</pose>
        <geometry><box><size>0.006 6.0 0.002</size></box></geometry>
        <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material>
      </visual>
      <visual name="gy5">
        <pose>0 -1.0 -0.9895999999999999 0 0 0</pose>
        <geometry><box><size>6.0 0.006 0.002</size></box></geometry>
        <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material>
      </visual>
      <visual name="gx6">
        <pose>-0.5 0 -0.9895999999999999 0 0 0</pose>
        <geometry><box><size>0.006 6.0 0.002</size></box></geometry>
        <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material>
      </visual>
      <visual name="gy6">
        <pose>0 -0.5 -0.9895999999999999 0 0 0</pose>
        <geometry><box><size>6.0 0.006 0.002</size></box></geometry>
        <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material>
      </visual>
      <visual name="gx7">
        <pose>0.0 0 -0.9895999999999999 0 0 0</pose>
        <geometry><box><size>0.006 6.0 0.002</size></box></geometry>
        <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material>
      </visual>
      <visual name="gy7">
        <pose>0 0.0 -0.9895999999999999 0 0 0</pose>
        <geometry><box><size>6.0 0.006 0.002</size></box></geometry>
        <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material>
      </visual>
