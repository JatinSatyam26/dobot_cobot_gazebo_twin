<!-- Solid-body inertia macros. Originally written for the M1 Pro placeholder;
     that model is gone (the official Dobot URDF ships real inertia tensors),
     so these now live with their only remaining user, the Pro 600. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${(mass/12.0)*(y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(mass/12.0)*(x*x + z*z)}" iyz="0.0"
               izz="${(mass/12.0)*(x*x + y*y)}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="inertial_cylinder" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${(mass/12.0)*(3.0*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
               iyy="${(mass/12.0)*(3.0*radius*radius + length*length)}" iyz="0.0"
               izz="${0.5*mass*radius*radius}"/>
    </inertial>
  </xacro:macro>
</robot>
